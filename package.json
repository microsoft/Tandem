{
  "name": "@tandem/canvas-extension",
  "version": "1.1.15",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "tsx --test tests/index.test.ts tests/execution-panels-react.test.tsx tests/requirements-panel.test.ts tests/review-process-panels.test.tsx tests/sketch-panel.test.tsx tests/speech-react.test.ts tests/browser-ui.test.ts",
    "eval": "tsx scripts/evaluate.ts",
    "build": "tsx scripts/build.ts",
    "build:browser": "tsx scripts/build.ts --browser",
    "browser": "npm run build:browser && tsx scripts/browser.ts run",
    "pack:browser": "npm run check && npm run build:browser && tsx scripts/browser.ts pack",
    "test:browser": "npm run build:browser && tsx scripts/browser-smoke.ts",
    "build:desktop:runtime": "tsx scripts/build.ts --desktop",
    "build:desktop": "tsx scripts/desktop.ts build",
    "desktop": "npm run build:desktop && tsx scripts/desktop.ts run",
    "pack:desktop": "npm run pack && npm run build:desktop && tsx scripts/desktop.ts publish",
    "test:desktop": "tsx scripts/desktop.ts check && tsx scripts/desktop-smoke.ts",
    "dev": "tsx scripts/build.ts --watch",
    "check": "tsc --project stage2/tandem/tsconfig.types.json && tsc --noEmit && tsc --project tsconfig.core.json",
    "pack": "npm run check && npm run build && tsx scripts/pack.ts"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "26.3.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/jsdom": "30.0.0",
    "@types/ws": "8.18.1",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@github/copilot": "1.0.80",
    "@github/copilot-sdk": "1.0.11",
    "koffi": "3.1.6",
    "@azure/identity": "4.13.2",
    "microsoft-cognitiveservices-speech-sdk": "1.51.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "radix-ui": "1.6.7",
    "lucide-react": "1.45.0",
    "ws": "8.21.3"
  }
}
