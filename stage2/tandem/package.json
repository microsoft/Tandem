{
  "name": "@tandem/app",
  "version": "0.1.0",
  "description": "Tandem extension, browser renderer and shared runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --check src/extension.mjs",
    "test": "npm run test:shared && npm run test:canvas",
    "test:shared": "node --import tsx --test test/shared/*.test.ts",
    "test:canvas": "node --test test/*.test.mjs",
    "build:artifacts": "node scripts/bundle-artifacts.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "jpeg-js": "0.4.4",
    "ajv": "8.17.1",
    "marked": "15.0.12",
    "css-tree": "3.1.0",
    "esbuild": "0.28.2",
    "mermaid": "12.2.0",
    "parse5": "7.3.0"
  }
}
